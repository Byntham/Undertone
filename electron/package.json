{
  "name": "undertone-electron",
  "version": "1.8.1",
  "private": true,
  "description": "Push-to-talk dictation for Windows",
  "main": "dist/main/main/main.js",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && npm run build:native && tsc -p tsconfig.build.json && vite build",
    "test": "npm run build:native && npm run test:built",
    "test:built": "vitest run --config vitest.config.mts",
    "eval:cleanup:luna": "npm run build:native && vitest run --config vitest.eval.config.mts",
    "start": "npm run build && node scripts/run-electron.mjs .",
    "clean:release": "node -e \"require('node:fs').rmSync('release',{recursive:true,force:true})\"",
    "package:built": "npm run clean:release && electron-builder --win --x64",
    "package": "npm run build && npm run package:built",
    "smoke:package": "node scripts/package-smoke.mjs",
    "smoke:package:local": "node scripts/package-smoke.mjs --local",
    "smoke:audio": "node scripts/run-electron.mjs scripts/audio-smoke.cjs",
    "test:turn-draft-native": "npm run build && node scripts/test-turn-draft-native.mjs",
    "verify": "npm run typecheck && npm run build && npm run test:built"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.4",
    "@types/ws": "8.18.1",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@10.9.8",
  "build": {
    "appId": "com.undertone.desktop",
    "productName": "Undertone",
    "asar": true,
    "directories": {
      "buildResources": "../assets",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/native/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/native",
        "to": "native",
        "filter": [
          "Undertone.WinHost.exe"
        ]
      },
      {
        "from": "../assets",
        "to": "assets",
        "filter": [
          "icon.png",
          "icon.ico"
        ]
      }
    ],
    "win": {
      "icon": "icon.ico",
      "publish": {
        "provider": "github",
        "owner": "Byntham",
        "repo": "Undertone",
        "releaseType": "release"
      },
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "Undertone-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "8.21.3"
  }
}
